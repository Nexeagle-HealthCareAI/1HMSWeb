# Configure the public URL for the application here.
# For local testing with mobile devices, set this to http://<YOUR_LOCAL_IP>:PORT (e.g., http://192.168.1.5:5173)
# For production, set this to your hosted domain (e.g., http://<FRONTEND_VM_IP>:81)
VITE_APP_URL=http://192.168.204.1:5173

# Optional: Override API URL if needed
# VITE_API_BASE_URL=https://1hms-dev-api.nexeagle.com

# Mapbox public access token (pk.*) -- powers the hospital/lab GPS location picker map.
# Get one at https://account.mapbox.com/access-tokens/. Restrict it to this app's domain(s)
# in the Mapbox dashboard before deploying, since this token ships to the browser.
VITE_MAPBOX_TOKEN=
