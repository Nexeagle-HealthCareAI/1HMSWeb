# Copy to e2e/.env.e2e (gitignored) and fill in real values - never commit this file with
# real credentials. All three are required to run `npm run test:e2e`.

# The dev site's own URL (frontend), not the API. e.g. http://151.185.45.77:81
E2E_BASE_URL=

# A real hospital-admin (or doctor) login on that environment.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=

# Sign-up and onboarding journey (project "onboarding", see e2e/README.md). Optional: skipped when unset.
# A tester number listed in STAFF_TESTER_MOBILES on the Dev API, and the DEV_TESTER_RESET_KEY secret.
E2E_TESTER_MOBILE=
E2E_TESTER_RESET_KEY=
# The Dev API (default https://1hms-dev-api.nexeagle.com)
E2E_API_URL=
