# Copy to e2e/.env.e2e (gitignored) and fill in real values - never commit this file with
# real credentials. All three are required to run `npm run test:e2e`.

# The dev site's own URL (frontend), not the API. e.g. http://151.185.45.77:81
E2E_BASE_URL=

# A real hospital-admin (or doctor) login on that environment.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=
